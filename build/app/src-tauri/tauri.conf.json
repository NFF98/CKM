{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CAKAMI",
  "version": "0.1.5",
  "identifier": "com.nff98.ckm.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "CAKAMI", "width": 480, "height": 800 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
